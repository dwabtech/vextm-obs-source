PROJECT := vextm-source
SHAREDOBJ := $(PROJECT).so

SRCS = platform-posix.c \
	   vextm-source.c \
	   vextm-thread.c \
	   colorbars.c

OBS_SOURCE := ./obs-studio

CC = gcc
STRIP = strip

CFLAGS = -m64 -Wall -fPIC
INCLUDES = -I. -I$(OBS_SOURCE)/libobs
LIBS = -L/usr/lib/x86_64-linux-gnu -static-libgcc -Wl,-Bdynamic -lobs -lpthread

XDG_DATA_HOME ?= $(HOME)/.local/share
PLUGIN_DIR = $(XDG_DATA_HOME)/obs-studio/plugins/$(PROJECT)

OBJS += ${SRCS:.c=.o}

.PHONY: install clean all zip

all: $(SHAREDOBJ)

$(SHAREDOBJ): $(OBJS)
	@echo "Linking $@..."
	$(CC) -shared -o $@ $(OBJS) $(LIBS)

.c.o:
	@echo "Compiling $<..."
	@$(CC) -c $< -o $@ $(CFLAGS) $(CXXFLAGS) $(INCLUDES)

install: $(SHAREDOBJ)
	mkdir -p "$(PLUGIN_DIR)"
	cp $(SHAREDOBJ) "$(PLUGIN_DIR)/"
	cp -r data "$(PLUGIN_DIR)/"

zip: $(SHAREDOBJ)
	/bin/rm -rf $(PROJECT)/
	rm -f $(PROJECT).zip
	mkdir -p $(PROJECT)
	cp $(SHAREDOBJ) $(PROJECT)/
	$(STRIP) $(PROJECT)/$(SHAREDOBJ)
	cp -r data $(PROJECT)/
	zip -r $(PROJECT).zip $(PROJECT)/

clean:
	rm -f $(SHAREDOBJ)
	rm -f $(OBJS)
	rm -rf dist
	rm -f *.out
	/bin/rm -rf $(PROJECT)/
	rm -f $(PROJECT).zip
